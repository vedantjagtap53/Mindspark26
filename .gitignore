# Allowlist: everything is ignored unless listed below.
*

# Root files
!.gitignore
!.env.example
!.prettierignore
!.prettierrc.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.base.json
!eslint.config.js
!README.md
!CLAUDE.md
!PRD.md
!IMPLEMENTATION_STATUS.md

# Source and project folders
!apps/
!apps/**
!packages/
!packages/**
!services/
!services/**
!supabase/
!supabase/**
!docs/
!docs/**
!scripts/
!scripts/**
!tests/
!tests/**

# Never upload, even inside the folders above

# Dependencies
node_modules/

# Build output and tool caches
dist/
build/
.vite/
.turbo/
.cache/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Local environment files and secrets (keep safe-to-share templates)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
serviceAccountKey.json

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Python virtual environments, bytecode, and test/tool caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated RAG vector database
services/rag/rag/store/

# Runtime logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# OS and editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
