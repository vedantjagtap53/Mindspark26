NODE_ENV=development
API_PORT=4000

# Firebase SQL Connect, the only database. Project, service ID and location are required when
# NODE_ENV=production. Service-account credentials are read by the API's
# database adapter only. If FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY are
# empty, Application Default Credentials are used.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase SQL Connect service (must match dataconnect/dataconnect.yaml).
FIREBASE_SQL_CONNECT_SERVICE_ID=
FIREBASE_SQL_CONNECT_LOCATION=

# Optional: point firebase-admin at the local SQL Connect emulator, e.g. 127.0.0.1:9399
# DATA_CONNECT_EMULATOR_HOST=

MARKET_DATA_API_KEY=

# Live level for Mode B (ELN/CPN), MVP: Finnhub real-time trades over WebSocket (backend only;
# the browser gets prices through /api/live). Free key at https://finnhub.io. Covers US stocks and
# crypto (e.g. AAPL, BINANCE:BTCUSDT), not Nifty 50. Leave empty to disable live levels.
FINNHUB_API_KEY=
FINNHUB_WS_URL=wss://ws.finnhub.io

# Live level, future scope: Upstox market data feed over WebSocket, used only when
# FINNHUB_API_KEY is empty. Use an Upstox *Analytics* token (long-lived, read-only).
# The RM can always enter the level manually.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_URL=https://api.upstox.com/v3
# A live price older than this many seconds is rejected (stale, or market closed).
MARKET_DATA_MAX_AGE_SECONDS=120

# Daily FX reference rates for DCD (Frankfurter). Accepts rates up to this many days old.
FX_API_URL=https://api.frankfurter.dev
FX_RATE_MAX_AGE_DAYS=4

# Daily closes for the Mode A fan chart: none (default) or yahoo. Yahoo Finance is free and needs
# no key, but it is unofficial (no SLA; Yahoo's terms apply). History is shown only when its close
# on the forecast's as-of date matches the forecast spot.
MARKET_HISTORY_PROVIDER=none
MARKET_HISTORY_API_URL=https://query1.finance.yahoo.com
# Forecast service (services/forecast). Example: http://127.0.0.1:8000/v1
# AI_API_KEY must equal the service's FORECAST_API_KEY.
AI_API_URL=
AI_API_KEY=
# Timeout for POST {AI_API_URL}/forecast (Mode A). Default 15000.
AI_FORECAST_TIMEOUT_MS=15000

# Explanation and chat service (services/rag), e.g. http://127.0.0.1:8001.
# RAG_API_KEY is sent as X-API-Key; `npm run dev:rag` passes it to the service as SERVICE_API_KEY.
# The service also needs GOOGLE_API_KEY in services/rag/.env.
RAG_API_URL=
RAG_API_KEY=
RAG_TIMEOUT_MS=90000

# Suitability: concentration above this percent of the portfolio is flagged (default 25).
SUITABILITY_CONCENTRATION_LIMIT_PCT=25
