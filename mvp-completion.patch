+
+const appWith = (repositories: Repositories | undefined) =>
+  createApp(buildConfig(parseEnv({})), silentLogger, {
+    marketData: createMarketDataService({}),
+    rag,
+    repositories,
+  });
+
+const eln = {
+  underlying: { symbol: '^NSEI', assetClass: 'index' },
+  notional: 1_000_000,
+  tenorDays: 365,
+  strikePct: 100,
+  couponPct: 10,
+  barrierPct: 80,
+  barrierType: 'European',
+};
+const profile = {
+  riskAppetite: 'high',
+  horizonMonths: 24,
